language = C
headers = engine.h conversation.h embedding_engine.h error_reporter.h
# No function of these headers gets a binding, only the types the declarations below use. A binding is a reference that
# the app's link has to resolve, even in an app that has this library in its dependencies and never calls it.
headerFilter = no_header_of_the_runtime
excludedFunctions = litertlm_kmp_runtime
nonStrictEnums = LiteRtLmStatusCode

# No linkerOpts on purpose: linker options in a .def file reach every consumer's link, and the framework's location is
# the app's business. The headers are copied from LiteRT-LM v0.19.1 c/ (see NOTICE).
---
#include <dlfcn.h>
#include <os/proc.h>

// iOS 13+. How much more this process can allocate before the system kills it. See Preflight.kt.
static inline size_t litertlm_kmp_available_memory(void) { return os_proc_available_memory(); }

// Every function of the runtime that this library calls: return type, name, parameters, arguments.
#define LITERTLM_KMP_FUNCTIONS(F) \
  F(LiteRtLmStatusCode, litert_lm_conversation_cancel_process, (LiteRtLmConversation* conversation), (conversation)) \
  F(LiteRtLmStatusCode, litert_lm_conversation_config_create, (LiteRtLmConversationConfig** out_config), (out_config)) \
  F(void, litert_lm_conversation_config_delete, (LiteRtLmConversationConfig* config), (config)) \
  F(LiteRtLmStatusCode, litert_lm_conversation_config_set_messages, \
    (LiteRtLmConversationConfig* config, const char* messages_json), (config, messages_json)) \
  F(LiteRtLmStatusCode, litert_lm_conversation_config_set_session_config, \
    (LiteRtLmConversationConfig* config, const LiteRtLmSessionConfig* session_config), (config, session_config)) \
  F(LiteRtLmStatusCode, litert_lm_conversation_config_set_tools, \
    (LiteRtLmConversationConfig* config, const char* tools_json), (config, tools_json)) \
  F(LiteRtLmStatusCode, litert_lm_conversation_create, \
    (LiteRtLmEngine* engine, LiteRtLmConversationConfig* config, LiteRtLmConversation** out_conversation), \
    (engine, config, out_conversation)) \
  F(void, litert_lm_conversation_delete, (LiteRtLmConversation* conversation), (conversation)) \
  F(LiteRtLmStatusCode, litert_lm_conversation_get_token_count, \
    (LiteRtLmConversation* conversation, size_t* out_count), (conversation, out_count)) \
  F(LiteRtLmStatusCode, litert_lm_conversation_send_message_stream, \
    (LiteRtLmConversation* conversation, const char* message_json, const char* extra_context, \
     const LiteRtLmConversationOptionalArgs* optional_args, LiteRtLmStreamCallback callback, void* callback_data), \
    (conversation, message_json, extra_context, optional_args, callback, callback_data)) \
  F(LiteRtLmStatusCode, litert_lm_embedding_engine_compute_embedding, \
    (LiteRtLmEmbeddingEngine* engine, const LiteRtLmInputData* const* inputs, size_t num_inputs, \
     const LiteRtLmEmbeddingOptions* options, LiteRtLmEmbeddingResponse** out_response), \
    (engine, inputs, num_inputs, options, out_response)) \
  F(LiteRtLmStatusCode, litert_lm_embedding_engine_create, \
    (const LiteRtLmEmbeddingEngineSettings* settings, LiteRtLmEmbeddingEngine** out_engine), \
    (settings, out_engine)) \
  F(void, litert_lm_embedding_engine_delete, (LiteRtLmEmbeddingEngine* engine), (engine)) \
  F(LiteRtLmStatusCode, litert_lm_embedding_engine_settings_create, \
    (const char* model_path, const char* backend_str, const char* vision_backend_str, \
     const char* audio_backend_str, LiteRtLmEmbeddingEngineSettings** out_settings), \
    (model_path, backend_str, vision_backend_str, audio_backend_str, out_settings)) \
  F(void, litert_lm_embedding_engine_settings_delete, (LiteRtLmEmbeddingEngineSettings* settings), (settings)) \
  F(LiteRtLmStatusCode, litert_lm_embedding_engine_settings_set_cache_dir, \
    (LiteRtLmEmbeddingEngineSettings* settings, const char* cache_dir), (settings, cache_dir)) \
  F(LiteRtLmStatusCode, litert_lm_embedding_engine_settings_set_max_input_length, \
    (LiteRtLmEmbeddingEngineSettings* settings, int max_input_length), (settings, max_input_length)) \
  F(LiteRtLmStatusCode, litert_lm_embedding_engine_settings_set_num_threads, \
    (LiteRtLmEmbeddingEngineSettings* settings, int num_threads), (settings, num_threads)) \
  F(LiteRtLmStatusCode, litert_lm_embedding_options_create, (LiteRtLmEmbeddingOptions** out_options), (out_options)) \
  F(void, litert_lm_embedding_options_delete, (LiteRtLmEmbeddingOptions* options), (options)) \
  F(LiteRtLmStatusCode, litert_lm_embedding_options_set_insert_special_tokens, \
    (LiteRtLmEmbeddingOptions* options, bool insert_special_tokens), (options, insert_special_tokens)) \
  F(LiteRtLmStatusCode, litert_lm_embedding_options_set_normalize, \
    (LiteRtLmEmbeddingOptions* options, bool normalize), (options, normalize)) \
  F(LiteRtLmStatusCode, litert_lm_embedding_options_set_output_size, \
    (LiteRtLmEmbeddingOptions* options, int output_size), (options, output_size)) \
  F(void, litert_lm_embedding_response_delete, (LiteRtLmEmbeddingResponse* response), (response)) \
  F(LiteRtLmStatusCode, litert_lm_embedding_response_get_size, \
    (const LiteRtLmEmbeddingResponse* response, size_t* out_size), (response, out_size)) \
  F(LiteRtLmStatusCode, litert_lm_embedding_response_get_values, \
    (const LiteRtLmEmbeddingResponse* response, const float** out_values), (response, out_values)) \
  F(LiteRtLmStatusCode, litert_lm_engine_create, \
    (const LiteRtLmEngineSettings* settings, LiteRtLmEngine** out_engine), (settings, out_engine)) \
  F(void, litert_lm_engine_delete, (LiteRtLmEngine* engine), (engine)) \
  F(LiteRtLmStatusCode, litert_lm_engine_settings_create, \
    (const char* model_path, const char* backend_str, const char* vision_backend_str, \
     const char* audio_backend_str, LiteRtLmEngineSettings** out_settings), \
    (model_path, backend_str, vision_backend_str, audio_backend_str, out_settings)) \
  F(void, litert_lm_engine_settings_delete, (LiteRtLmEngineSettings* settings), (settings)) \
  F(LiteRtLmStatusCode, litert_lm_engine_settings_set_cache_dir, \
    (LiteRtLmEngineSettings* settings, const char* cache_dir), (settings, cache_dir)) \
  F(LiteRtLmStatusCode, litert_lm_engine_settings_set_max_num_tokens, \
    (LiteRtLmEngineSettings* settings, int max_num_tokens), (settings, max_num_tokens)) \
  F(LiteRtLmStatusCode, litert_lm_engine_settings_set_num_threads, \
    (LiteRtLmEngineSettings* settings, int num_threads), (settings, num_threads)) \
  F(const char*, litert_lm_get_last_error_message, (void), ()) \
  F(LiteRtLmStatusCode, litert_lm_input_data_create, \
    (LiteRtLmInputDataType type, const void* data, size_t size, LiteRtLmInputData** out_input_data), \
    (type, data, size, out_input_data)) \
  F(void, litert_lm_input_data_delete, (LiteRtLmInputData* input_data), (input_data)) \
  F(LiteRtLmStatusCode, litert_lm_sampler_params_create, \
    (LiteRtLmSamplerType type, LiteRtLmSamplerParams** out_params), (type, out_params)) \
  F(void, litert_lm_sampler_params_delete, (LiteRtLmSamplerParams* params), (params)) \
  F(LiteRtLmStatusCode, litert_lm_sampler_params_set_seed, \
    (LiteRtLmSamplerParams* params, int32_t seed), (params, seed)) \
  F(LiteRtLmStatusCode, litert_lm_sampler_params_set_temperature, \
    (LiteRtLmSamplerParams* params, float temperature), (params, temperature)) \
  F(LiteRtLmStatusCode, litert_lm_sampler_params_set_top_k, \
    (LiteRtLmSamplerParams* params, int32_t top_k), (params, top_k)) \
  F(LiteRtLmStatusCode, litert_lm_sampler_params_set_top_p, \
    (LiteRtLmSamplerParams* params, float top_p), (params, top_p)) \
  F(LiteRtLmStatusCode, litert_lm_session_config_create, (LiteRtLmSessionConfig** out_config), (out_config)) \
  F(void, litert_lm_session_config_delete, (LiteRtLmSessionConfig* config), (config)) \
  F(LiteRtLmStatusCode, litert_lm_session_config_set_sampler_params, \
    (LiteRtLmSessionConfig* config, const LiteRtLmSamplerParams* sampler_params), (config, sampler_params)) \
  F(LiteRtLmStatusCode, litert_lm_stream_chunk_get_error, \
    (const LiteRtLmStreamChunk* chunk, const char** out_error), (chunk, out_error)) \
  F(LiteRtLmStatusCode, litert_lm_stream_chunk_get_text, \
    (const LiteRtLmStreamChunk* chunk, const char** out_text), (chunk, out_text)) \
  F(LiteRtLmStatusCode, litert_lm_stream_chunk_is_final, \
    (const LiteRtLmStreamChunk* chunk, bool* out_is_final), (chunk, out_is_final))

typedef struct {
#define LITERTLM_KMP_FIELD(ret, name, params, args) __typeof__(&name) name;
  LITERTLM_KMP_FUNCTIONS(LITERTLM_KMP_FIELD)
} LitertlmKmpRuntime;

static inline LitertlmKmpRuntime* litertlm_kmp_runtime(void) {
  static LitertlmKmpRuntime runtime;
  return &runtime;
}

// dl_<name> calls <name>. Only after litertlm_kmp_load_runtime() has returned NULL.
#define LITERTLM_KMP_CALL(ret, name, params, args) \
  static inline ret dl_##name params { return litertlm_kmp_runtime()->name args; }
LITERTLM_KMP_FUNCTIONS(LITERTLM_KMP_CALL)

// Finds the functions: NULL, or what is wrong. Not thread-safe. An app that links CLiteRTLM.framework has it loaded. A
// linker told to strip unused dylibs leaves it unloaded in the app's Frameworks folder: nothing here refers to it.
static inline const char* litertlm_kmp_load_runtime(void) {
  void* library = RTLD_DEFAULT;
  if (dlsym(library, "litert_lm_engine_create") == NULL) {
    library = dlopen("@rpath/CLiteRTLM.framework/CLiteRTLM", RTLD_NOW | RTLD_GLOBAL);
    if (library == NULL) return dlerror();
  }
  LitertlmKmpRuntime* runtime = litertlm_kmp_runtime();
#define LITERTLM_KMP_FIND(ret, name, params, args) \
  runtime->name = (__typeof__(&name))dlsym(library, #name); \
  if (runtime->name == NULL) return #name;
  LITERTLM_KMP_FUNCTIONS(LITERTLM_KMP_FIND)
  return NULL;
}
